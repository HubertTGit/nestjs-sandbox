# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/mydb
CLOUD_SQL_PROXY_PORT=5433
CLOUD_SQL_INSTANCE=your-project:your-region:your-instance

# App URL (used for JWT issuer, OIDC callback URL, and Secure cookie detection)
APP_URL=http://localhost:3000
PORT=3000

# Signing secret for access token JWTs (at least 32 bytes)
JWT_SECRET=change-me-to-a-random-32-byte-secret-value

# Google OAuth / ID Token Verification
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-web-client-secret
# Optional comma-separated additional Google OAuth Client IDs (e.g. Android/iOS if not using serverClientId)
GOOGLE_ALLOWED_CLIENT_IDS=

# Comma-separated allowed browser origins for CORS (e.g. http://localhost:5173,https://app.example.com)
CORS_ORIGINS=http://localhost:5173

# Optional NestJS Observe telemetry credentials
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
